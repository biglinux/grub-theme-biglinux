# Maintainer: Bruno Goncalves <bigbruno@gmail.com>

pkgname=grub-theme-biglinux
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL')
url="https://github.com/biglinux/grub-theme-biglinux"
pkgdesc="Grub theme"
# The themed passphrase prompt is built at install time out of parts that
# belong to other packages. terminus-font owns the font it embeds: without it
# the script finds none, gives up, and the whole feature silently never
# happens on that machine.
depends=('grub' 'terminus-font' 'cryptsetup' 'gettext' 'util-linux' 'tar' 'awk')
optdepends=('sbctl: sign the rebuilt bootloader on a Secure Boot machine')
source=("git+https://github.com/biglinux/grub-theme-biglinux.git")
md5sums=(SKIP)


package() {
    cp -r "${srcdir}/grub-theme-biglinux/grub-theme-biglinux/boot/" "${pkgdir}/"
    cp -r "${srcdir}/grub-theme-biglinux/grub-theme-biglinux/usr/" "${pkgdir}/"

    # git tracks the theme and its artwork as executable; only scripts are.
    find "${pkgdir}/boot" -type f -exec chmod 0644 {} +
}
